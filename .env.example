# Copy to .env and fill in. Never commit .env.

# ---- the app ----
PORT=8787
APP_URL=http://localhost:5173     # where the web app is served (redirect target after sign-in)
SERVER_URL=http://localhost:8787  # public URL of this server (OAuth callbacks)
SESSION_SECRET=change-me-to-a-long-random-string   # also signs the tokens the agents use to reach /mcp
DEV_LOGIN=1                       # 1 enables POST /api/auth/dev (local testing only)
# GOOGLE_CLIENT_ID=               # sign in with Google through your own OAuth client;
# GOOGLE_CLIENT_SECRET=           # redirect URI: <SERVER_URL>/api/auth/google/callback
ALLOWED_EMAILS=                   # comma-separated emails allowed to sign in; empty = anyone who can reach the app
# DB_PATH=./data/grokbot.db       # where the app keeps its SQLite database

# ---- the agents (Hermes) ----
HERMES_BIN=hermes                 # the hermes CLI; it starts one gateway per extra bot
HERMES_URL=http://127.0.0.1:8642  # API server of the agent that already runs (the first bot)
# HERMES_HOME_PRIMARY=~/.hermes   # that agent's home (memory files, .env with API_SERVER_KEY)
# HERMES_KEY=                     # its API key, when not readable from <home>/.env
# ENGINES_DIR=./data/engines      # homes of the extra bots; must be outside ~/.hermes
# ENGINE_PORT_BASE=8650
# MCP_BASE_URL=http://127.0.0.1:8787   # how the agents reach this server
# EXTRA_MCP_SERVERS=              # JSON object of Hermes mcp_servers entries every extra bot gets
# TRUST_MODEL=                     # model that checks each action against the user's words; default XAI_MODEL
# TRUST_MODEL_URL=https://api.x.ai/v1   # any OpenAI-compatible API (it is sent XAI_API_KEY)
# ASK_BOT_WAIT_SECONDS=540        # how long a bot waits for another bot's answer (ask_bot) before it arrives later as a message; at most 1500
# CLAUDE_BIN=claude               # the Claude Code CLI, for bots that run on it; offered only when installed and signed in here
# MODEL_PRICES=                   # JSON of extra or changed list prices, US$ per million tokens, e.g. {"grok-4.7":{"input":3,"output":15}} (cacheRead, cacheWrite optional)
# CLI_SANDBOX=docker              # run each Claude Code bot turn in its own container (R8); needs Docker. Unset: on this host, as the server's user
# CLAUDE_CODE_OAUTH_TOKEN=        # with CLI_SANDBOX=docker: your subscription token from `claude setup-token`; stays on the server, added by its model proxy
# CLI_INTERNET=off                # with CLI_SANDBOX=docker: containerized bots reach only the app and the model, no public internet (default: on)
# CLI_MODEL_UPSTREAM=https://api.anthropic.com   # where the model proxy sends containerized bots' model requests
# PRIMARY_BOT_NAME=Doug
# PRIMARY_BOT_LABEL=Chief of Staff

# ---- the one computer every bot works on (one screen per bot) ----
# Either an Orgo computer:
ORGO_API_KEY=                     # or ORGO_API_KEY_FILE=/path/to/file
ORGO_COMPUTER_ID=
# ...or a Linux container on this machine (Colima, OrbStack, Docker Desktop). No Orgo account needed.
# HQ_BOX=docker
# HQ_DOCKER_BIN=docker
# HQ_DOCKER_CONTAINER=hq-box      # also names its image and data volume
# HQ_SCREEN_SIZE=1440x900
HQ_LOCAL=0                        # 1 when this server runs on that computer (production); not with HQ_BOX=docker
# PRIMARY_CDP_URL=http://127.0.0.1:9333   # a Chrome the first bot already owns on the default screen
MAX_BOTS=4                        # Orgo allows four screens on one Linux computer

# ---- connectors, X research, voice ----
COMPOSIO_API_KEY=                 # optional; a project API key (ak_...) with full access. Empty = no connected apps
XAI_API_KEY=                      # x_search (research on X) and the voice modes
XAI_MODEL=grok-4.7
# XAI_VOICE_MODEL=grok-voice-latest
# XAI_VOICE_USD_PER_MIN=0.08        # rates for the cost estimate shown in voice calls;
# XAI_VOICE_USD_PER_TEXT_ITEM=0.004 # change them when the provider's prices change
# XAI_STT_MODEL=grok-voice-transcribe-2.0
